{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$PLUGIN_ROOT/hooks/research_markdown_postprocess_hook.py\"",
            "timeout": 30,
            "statusMessage": "Normalizing generated research Markdown"
          }
        ]
      }
    ]
  }
}
